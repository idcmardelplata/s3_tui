# s3-tui configuration
# Location: $HOME/.config/s3-tui/config.toml
# A missing file is fine; every field below is optional and has a sensible default.

# AWS region. Overridden by the AWS_REGION environment variable.
region = "us-east-1"

# S3-compatible endpoint (LocalStack, MinIO, etc.). When unset, the standard
# AWS regional endpoint is used. Overridden by the S3_ENDPOINT environment variable.
#endpoint = "http://localhost:4566"

# Use path-style URLs (bucket in the request path instead of a subdomain).
# Only meaningful when an endpoint is set. Standard AWS uses virtual-hosted style.
#force_path_style = true

# Named profile from ~/.aws/credentials to use for credential resolution.
# When unset, the standard AWS credential chain applies.
#profile = "my-profile"

# Static credentials. When this table is omitted, the standard AWS credential
# chain is used (env vars, ~/.aws/credentials, IAM role, etc.). Only the
# access_key_id / secret_access_key pair is required to enable this.
# [credentials]
# access_key_id = "AKIA..."
# secret_access_key = "..."
# session_token = ""